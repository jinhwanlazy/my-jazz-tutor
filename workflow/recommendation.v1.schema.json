                              "maximum": 3.5
                            },
                            "duration": {
                              "type": "number",
                              "enum": [
                                0.5,
                                1,
                                2,
                                4
                              ]
                            },
                            "notes": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^[A-G][b#]?[0-8]$"
                              },
                              "minItems": 0,
                              "maxItems": 6
                            }
                          },
                          "required": [
                            "beat",
                            "duration",
                            "notes"
