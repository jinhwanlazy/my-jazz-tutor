{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "evidence_ids",
    "stretch",
    "form",
    "material_reason",
    "material_requests",
    "example_requirements"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "stretch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "form": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "material_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "material_requests": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "query",
          "pages"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "pages": {
            "type": "array",
            "minItems": 0,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            }
          }
        }
      }
    },
    "example_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "bars",
        "focus"
      ],
      "properties": {
        "key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 10
            },
            {
              "type": "null"
            }
          ]
        },
        "bars": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            {
              "type": "null"
            }
          ]
        },
        "focus": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    }
  }
}
